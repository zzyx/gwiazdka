-- Freeze the clock: Wednesday 23 September 2026, 10:00 in Warsaw.
create or replace function private.clock() returns timestamptz language sql stable
  as $$ select timestamptz '2026-09-23 10:00 Europe/Warsaw' $$;

create function pg_temp.set_clock(at timestamptz) returns void language plpgsql as $$
declare
  was text := current_setting('role');
begin
  perform set_config('role', 'postgres', true);
  execute format(
    'create or replace function private.clock() returns timestamptz language sql stable as $f$ select %L::timestamptz $f$',
    at);
  perform set_config('role', was, true);
end $$;

create function pg_temp.act_as(uid uuid) returns void language sql as $$
  select set_config('request.jwt.claims', json_build_object('sub', uid, 'role', 'authenticated')::text, true);
  select set_config('role', 'authenticated', true);
$$;

create function pg_temp.act_as_admin() returns void language sql as $$
  select set_config('role', 'postgres', true);
  select set_config('request.jwt.claims', '', true);
$$;
