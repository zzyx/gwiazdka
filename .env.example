# Copy to .env.local for local development. Real values live in Vercel's env vars.
# Local Supabase (`npx supabase start`) prints both values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Lets the server redeem a child's Join code. Never expose to the browser.
SUPABASE_SECRET_KEY=
